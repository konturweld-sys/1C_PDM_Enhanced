////////////////////////////////////////////////////////////////////////////////

Процедура ПДМ_ЗафиксироватьСбойСвязи() Экспорт

    МенеджерЗаписи =
        РегистрыСведений.ПДМ_СчетчикСбоевСвязиRabbitMQ.СоздатьМенеджерЗаписи();

    МенеджерЗаписи.Прочитать();

    МенеджерЗаписи.КоличествоОшибокПодряд =
        МенеджерЗаписи.КоличествоОшибокПодряд + 1;

    МенеджерЗаписи.ДатаПоследнейОшибки = ТекущаяДата();

    МенеджерЗаписи.Записать();

КонецПроцедуры


Процедура ПДМ_СброситьСчетчикСбоев() Экспорт

    МенеджерЗаписи =
        РегистрыСведений.ПДМ_СчетчикСбоевСвязиRabbitMQ.СоздатьМенеджерЗаписи();

    МенеджерЗаписи.Прочитать();

    МенеджерЗаписи.КоличествоОшибокПодряд = 0;
    МенеджерЗаписи.ДатаПоследнейОшибки = Неопределено;

    МенеджерЗаписи.Записать();

КонецПроцедуры


// Отправка сообщения через Telegram Bot API.
// Возвращает Истина только при HTTP-коде 200.

Функция ПДМ_ОтправитьВTelegram(
	НастройкиИнтеграции,
	ТекстСообщения)

	ТокенБота = НастройкиИнтеграции.TelegramТокенБота;
	IDЧата = НастройкиИнтеграции.TelegramIDЧАТА;

	Если ПустаяСтрока(ТокенБота)
		Или ПустаяСтрока(IDЧата) Тогда

		ЗаписьЖурналаРегистрации(
			"ПДМ.RabbitMQ.Telegram",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			"Не заполнены токен Telegram-бота или ID чата.");

		Возврат Ложь;

	КонецЕсли;

	Попытка

		ДанныеСообщения = Новый Структура;
		ДанныеСообщения.Вставить("chat_id", IDЧата);
		ДанныеСообщения.Вставить("text", ТекстСообщения);

		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();

		ЗаписатьJSON(ЗаписьJSON, ДанныеСообщения);

		СтрокаJSON = ЗаписьJSON.Закрыть();

		HTTPЗапрос = Новый HTTPЗапрос(
			"/bot" + ТокенБота + "/sendMessage");

		HTTPЗапрос.Заголовки.Вставить(
			"Content-Type",
			"application/json; charset=utf-8");

		HTTPЗапрос.УстановитьТелоИзСтроки(
			СтрокаJSON,
			КодировкаТекста.UTF8);

		Защита = Новый ЗащищенноеСоединениеOpenSSL(
			Новый СертификатКлиентаWindows(),
			Новый СертификатыУдостоверяющихЦентровWindows());

		HTTPСоединение = Новый HTTPСоединение(
			"api.telegram.org",
			443,
			,
			,
			,
			10,
			Защита);

		HTTPОтвет = HTTPСоединение.ВызватьHTTPМетод(
			"POST",
			HTTPЗапрос);

		Если HTTPОтвет.КодСостояния = 200 Тогда
			Возврат Истина;
		КонецЕсли;

		ЗаписьЖурналаРегистрации(
			"ПДМ.RabbitMQ.Telegram",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			"Telegram API вернул HTTP-код: "
				+ Строка(HTTPОтвет.КодСостояния));

		Возврат Ложь;

	Исключение

		ЗаписьЖурналаРегистрации(
			"ПДМ.RabbitMQ.Telegram",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			"Ошибка отправки Telegram-сообщения: "
				+ ОписаниеОшибки());

		Возврат Ложь;

	КонецПопытки;

КонецФункции