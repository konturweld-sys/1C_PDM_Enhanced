Функция СоздатьСтандартноеИзделиеИзCAD(Знач ХексСтрокаКодов) Экспорт

	ТекущийЭтап = "START";
	ТранзакцияНачата = Ложь;
	СозданныйОбъект = Неопределено;

	Попытка

		// ---------------------------------------------------------
		// DECODE
		// ---------------------------------------------------------

		ТекущийЭтап = "DECODE";
		ПолноеОбозначение = ДекодироватьHEXКТС(ХексСтрокаКодов);

		Если ПустаяСтрока(ПолноеОбозначение) Тогда
			ВызватьИсключение "После декодирования обозначение пустое.";
		КонецЕсли;

		// ---------------------------------------------------------
		// LOAD_RULES
		// ---------------------------------------------------------

		ТекущийЭтап = "LOAD_RULES";
		ПутьКФайлуПравил = "C:\Scripts\KTS_Parser_Rules_Template.csv";
		ФайлПравил = Новый Файл(ПутьКФайлуПравил);

		Если Не ФайлПравил.Существует() Тогда
			ВызватьИсключение
				"Не найден файл правил: " + ПутьКФайлуПравил;
		КонецЕсли;

		ТекстПравил = Новый ТекстовыйДокумент;
		ТекстПравил.Прочитать(ПутьКФайлуПравил);

		ТекстCSV = ТекстПравил.ПолучитьТекст();
		ТекстCSV = СтрЗаменить(ТекстCSV, Символы.ВК, "");

		Если Лев(ТекстCSV, 1) = Символ(65279) Тогда
			ТекстCSV = Сред(ТекстCSV, 2);
		КонецЕсли;

		Если ПустаяСтрока(ТекстCSV) Тогда
			ВызватьИсключение "Файл правил пуст.";
		КонецЕсли;

		ТекущийЭтап = "CSV_HEADER";
		СтрокиCSV = СтрРазделить(ТекстCSV, Символы.ПС);

		Если СтрокиCSV.Количество() < 2 Тогда
			ВызватьИсключение
				"В CSV нет строк с правилами после заголовка.";
		КонецЕсли;

		РазделительCSV = КТСОпределитьРазделительCSV(СтрокиCSV[0]);
		Заголовки = КТСРазобратьСтрокуCSV(
			СтрокиCSV[0], РазделительCSV);

		ИндексРесурса = КТСИндексКолонки(Заголовки, "ИмяРесурсаКТС");
		ИндексТипа = КТСИндексКолонки(Заголовки, "ТипИзделия");
		ИндексШаблона = КТСИндексКолонки(Заголовки, "ШаблонОбозначения");
		ИндексПоля = КТСИндексКолонки(Заголовки, "ПолеПараметра");
		ИндексСвойства = КТСИндексКолонки(Заголовки, "СвойствоPDM");
		ИндексПравила = КТСИндексКолонки(Заголовки, "ТипПравила");
		ИндексРазделителя = КТСИндексКолонки(Заголовки, "Разделитель");
		ИндексОбязательности = КТСИндексКолонки(Заголовки, "Обязательный");

		Если ИндексРесурса < 0
			Или ИндексТипа < 0
			Или ИндексПоля < 0
			Или ИндексСвойства < 0
			Или ИндексПравила < 0
			Или ИндексРазделителя < 0
			Или ИндексОбязательности < 0 Тогда

			ВызватьИсключение
				"В заголовке CSV отсутствует одна из обязательных колонок.";

		КонецЕсли;

		// ---------------------------------------------------------
		// DETERMINE_PRODUCT_TYPE
		// ---------------------------------------------------------

		ТекущийЭтап = "DETERMINE_PRODUCT_TYPE";

		Если Лев(ПолноеОбозначение, 5) = "Болт " Тогда
			ТипИзделия = "Болт";
			НачалоИмениРесурса = "Болты ГОСТ ";
		ИначеЕсли Лев(ПолноеОбозначение, 5) = "Винт " Тогда
			ТипИзделия = "Винт";
			НачалоИмениРесурса = "Винты ГОСТ ";
		ИначеЕсли Лев(ПолноеОбозначение, 6) = "Гайка " Тогда
			ТипИзделия = "Гайка";
			НачалоИмениРесурса = "Гайки ГОСТ ";
		Иначе
			ВызватьИсключение
				"Не удалось определить тип изделия по началу обозначения: "
				+ ПолноеОбозначение;
		КонецЕсли;

		// ---------------------------------------------------------
		// DETERMINE_GOST
		// ---------------------------------------------------------

		ТекущийЭтап = "DETERMINE_GOST";

		ПозицияГОСТ = Найти(ПолноеОбозначение, " ГОСТ ");

		Если ПозицияГОСТ = 0 Тогда
			ВызватьИсключение
				"В обозначении отсутствует номер ГОСТ: "
				+ ПолноеОбозначение;
		КонецЕсли;

		ХвостГОСТ = СокрЛП(Сред(
			ПолноеОбозначение,
			ПозицияГОСТ + СтрДлина(" ГОСТ ")));

		Если ПустаяСтрока(ХвостГОСТ) Тогда
			ВызватьИсключение
				"После ГОСТ не указан номер стандарта.";
		КонецЕсли;

		ПозицияПробелаГОСТ = Найти(ХвостГОСТ, " ");

		Если ПозицияПробелаГОСТ > 0 Тогда
			НомерГОСТ = Лев(ХвостГОСТ, ПозицияПробелаГОСТ - 1);
		Иначе
			НомерГОСТ = ХвостГОСТ;
		КонецЕсли;

		НомерГОСТ = СокрЛП(НомерГОСТ);

		Если ПустаяСтрока(НомерГОСТ) Тогда
			ВызватьИсключение
				"Не удалось определить номер ГОСТ.";
		КонецЕсли;

		ОжидаемыйРесурс = НачалоИмениРесурса + НомерГОСТ;

		// ---------------------------------------------------------
		// SELECT_RULESET
		// ---------------------------------------------------------

		ТекущийЭтап = "SELECT_RULESET";

		ПравилаНабора = Новый Массив;
		ИмяРесурсаКТС = "";
		ШаблонОбозначения = "";

		Для НомерСтроки = 1 По СтрокиCSV.Количество() - 1 Цикл

			СтрокаCSV = СтрокиCSV[НомерСтроки];

			Если ПустаяСтрока(СокрЛП(СтрокаCSV)) Тогда
				Продолжить;
			КонецЕсли;

			ПоляCSV = КТСРазобратьСтрокуCSV(
				СтрокаCSV, РазделительCSV);

			Если ПоляCSV.Количество() <= ИндексОбязательности Тогда
				Продолжить;
			КонецЕсли;

			Если СокрЛП(ПоляCSV[ИндексТипа]) <> ТипИзделия Тогда
				Продолжить;
			КонецЕсли;

			ТекущийРесурсСтроки = СокрЛП(
				ПоляCSV[ИндексРесурса]);

			Если ТекущийРесурсСтроки <> ОжидаемыйРесурс Тогда
				Продолжить;
			КонецЕсли;

			Если ПустаяСтрока(ИмяРесурсаКТС) Тогда

				ИмяРесурсаКТС = ТекущийРесурсСтроки;

				Если ИндексШаблона >= 0 Тогда
					ШаблонОбозначения = СокрЛП(
						ПоляCSV[ИндексШаблона]);
				КонецЕсли;

			КонецЕсли;

			Правило = Новый Структура;
			Правило.Вставить("ПолеПараметра",
				СокрЛП(ПоляCSV[ИндексПоля]));
			Правило.Вставить("СвойствоPDM",
				СокрЛП(ПоляCSV[ИндексСвойства]));
			Правило.Вставить("ТипПравила",
				СокрЛП(ПоляCSV[ИндексПравила]));
			Правило.Вставить("Разделитель",
				ПоляCSV[ИндексРазделителя]);
			Правило.Вставить("Обязательный",
				ВРег(СокрЛП(ПоляCSV[ИндексОбязательности]))
					= "ИСТИНА");

			ПравилаНабора.Добавить(Правило);

		КонецЦикла;

		Если ПустаяСтрока(ИмяРесурсаКТС) Тогда
			ВызватьИсключение
				"В CSV отсутствуют правила для ресурса «"
				+ ОжидаемыйРесурс
				+ "». Создание элемента отменено.";
		КонецЕсли;

		Если ПравилаНабора.Количество() = 0 Тогда
			ВызватьИсключение
				"Для ресурса «" + ИмяРесурсаКТС
				+ "» нет правил разбора.";
		КонецЕсли;

		// ---------------------------------------------------------
		// PREPARE_INPUT
		// ---------------------------------------------------------

		ТекущийЭтап = "PREPARE_INPUT";

		РабочееОбозначение = Лев(
			ПолноеОбозначение, ПозицияГОСТ - 1);

		РабочееОбозначение = СокрЛП(РабочееОбозначение);

		Если Лев(РабочееОбозначение, СтрДлина(ТипИзделия) + 1)
			= ТипИзделия + " " Тогда

			РабочееОбозначение = Сред(
				РабочееОбозначение, СтрДлина(ТипИзделия) + 2);

		КонецЕсли;

		РабочееОбозначение = СтрЗаменить(
			РабочееОбозначение, "×", "x");

		// ---------------------------------------------------------
		// PARSE
		// ---------------------------------------------------------

		ТекущийЭтап = "PARSE";

		РезультатРазбора = КТСРазобратьПоПравилам(
			РабочееОбозначение, ПравилаНабора);

		Если Не РезультатРазбора.Успех Тогда
			ВызватьИсключение
				"Ошибка разбора обозначения «"
				+ РабочееОбозначение + "»: "
				+ РезультатРазбора.Ошибка;
		КонецЕсли;

		// ---------------------------------------------------------
		// FIND_RESOURCE
		// ---------------------------------------------------------

		ТекущийЭтап = "FIND_RESOURCE";

		СсылкаРесурса = Справочники.aps_ЭлементыСправочников
			.НайтиПоНаименованию(ИмяРесурсаКТС);

		Если Не ЗначениеЗаполнено(СсылкаРесурса) Тогда
			ВызватьИсключение
				"Не найден ресурс КТС: " + ИмяРесурсаКТС;
		КонецЕсли;

		ОбъектРесурса = СсылкаРесурса.ПолучитьОбъект();

		// ---------------------------------------------------------
		// CHECK_EXACT_TARGET_NAME
		// ---------------------------------------------------------

		ТекущийЭтап = "CHECK_EXACT_TARGET_NAME";

		Для Каждого СтрокаСвязи Из ОбъектРесурса.ЭлементыРесурса Цикл

			Если Не ЗначениеЗаполнено(СтрокаСвязи.ЭлементСсылка) Тогда
				Продолжить;
			КонецЕсли;

			Если СтрокаСвязи.ЭлементСсылка.Наименование
				= ПолноеОбозначение Тогда

				Возврат "TEST_RESULT=DUPLICATE"
					+ Символы.ПС
					+ "SELECTED_RESOURCE=" + ИмяРесурсаКТС
					+ Символы.ПС
					+ "SELECTED_GOST=" + НомерГОСТ
					+ Символы.ПС
					+ "ELEMENT_NAME=" + ПолноеОбозначение;

			КонецЕсли;

		КонецЦикла;

		// ---------------------------------------------------------
		// DETERMINE_ELEMENT_KIND
		// ---------------------------------------------------------

		ТекущийЭтап = "DETERMINE_ELEMENT_KIND";
		ВидЭлемента = Справочники.aps_ВидыЭлементов.СтИзд;

		НачатьТранзакцию();
		ТранзакцияНачата = Истина;

		// ---------------------------------------------------------
		// CREATE_NATIVE_OBJECT
		// ---------------------------------------------------------

		ТекущийЭтап = "CREATE_NATIVE_OBJECT";

		МодульСоздания = Обработки.aps_СозданиеОбъектов.Создать();

		СозданныйОбъект = МодульСоздания.aps_СозданиеОбъектаPDM(
			ВидЭлемента,
			Новый ДеревоЗначений,
			Неопределено,
			Истина);

		Если СозданныйОбъект = Неопределено Тогда
			ВызватьИсключение
				"aps_СозданиеОбъектаPDM вернул Неопределено.";
		КонецЕсли;

		СозданныйОбъект.Наименование = ПолноеОбозначение;
		ДиагИмяПослеПрисвоения = Строка(СозданныйОбъект.Наименование);

		// ---------------------------------------------------------
		// CREATE_RESOURCE_PARAMETER_SET
		// ---------------------------------------------------------

		ТекущийЭтап = "CREATE_RESOURCE_PARAMETER_SET";

		МодульКТС = Обработки.aps_КонструкторскоТехнологическийСправочник.Создать();

		МодульКТС.aps_СоздатьНаборПараметровЭлементаРесурса(
			СозданныйОбъект, СсылкаРесурса);

		// ---------------------------------------------------------
		// RESOLVE_AND_WRITE_PARAMETERS
		// ---------------------------------------------------------

		ТекущийЭтап = "RESOLVE_AND_WRITE_PARAMETERS";

		Для Каждого Правило Из ПравилаНабора Цикл

			ИсходноеЗначение = РезультатРазбора.Параметры.Получить(
				Правило.ПолеПараметра);

			Если ИсходноеЗначение = Неопределено Тогда

				Если Правило.Обязательный Тогда
					ВызватьИсключение
						"Не разобрано обязательное поле: "
						+ Правило.ПолеПараметра;
				КонецЕсли;

				Продолжить;

			КонецЕсли;

			// -----------------------------------------------------
			// RESOLVE_CLASS / RESOLVE_AND_WRITE_PARAMETERS
			// -----------------------------------------------------

			Если Правило.СвойствоPDM = "Класс" Тогда
				ТекущийЭтап = "RESOLVE_CLASS";
			Иначе
				ТекущийЭтап = "RESOLVE_AND_WRITE_PARAMETERS";
			КонецЕсли;

			ИмяСвойстваPDM = Правило.СвойствоPDM;
			ЗначениеДляПоиска = ИсходноеЗначение;

			// Запятая заменяется точкой только для «Шаг резьбы».
			// Для «Метрическая резьба» сохраняется десятичная запятая.
			Если ИмяСвойстваPDM = "Шаг резьбы" Тогда
				ЗначениеДляПоиска = СтрЗаменить(
					ЗначениеДляПоиска, ",", ".");
			КонецЕсли;

			СсылкаСвойства = ПланыВидовХарактеристик.aps_Свойства
				.НайтиПоНаименованию(ИмяСвойстваPDM);

			Если Не ЗначениеЗаполнено(СсылкаСвойства) Тогда
				ВызватьИсключение
					"Не найдено существующее свойство PDM: "
					+ ИмяСвойстваPDM;
			КонецЕсли;

			ЗапросЗначения = Новый Запрос;
			ЗапросЗначения.Текст =
				"ВЫБРАТЬ ПЕРВЫЕ 1
				|	Значения.Ссылка КАК Ссылка
				|ИЗ
				|	Справочник.aps_ЗначенияСвойств КАК Значения
				|ГДЕ
				|	Значения.Владелец = &Свойство
				|	И Значения.Наименование = &Наименование";

			ЗапросЗначения.УстановитьПараметр(
				"Свойство", СсылкаСвойства);
			ЗапросЗначения.УстановитьПараметр(
				"Наименование", ЗначениеДляПоиска);

			ВыборкаЗначения = ЗапросЗначения.Выполнить().Выбрать();

			Если Не ВыборкаЗначения.Следующий() Тогда
				ВызватьИсключение
					"Не найдено существующее значение свойства «"
					+ ИмяСвойстваPDM + "»: "
					+ ЗначениеДляПоиска;
			КонецЕсли;

			СсылкаЗначения = ВыборкаЗначения.Ссылка;
			ПараметрНайден = Ложь;

			Для Каждого СтрокаПараметра
				Из СозданныйОбъект.Параметры Цикл

				ПараметрОбъекта = СтрокаПараметра.Параметр;

				Если ПараметрОбъекта.Свойство = СсылкаСвойства Тогда

					ОбъектПараметра = ПараметрОбъекта.ПолучитьОбъект();
					ОбъектПараметра.Значение = СсылкаЗначения;
					ОбъектПараметра.Записать();

					ПараметрНайден = Истина;
					Прервать;

				КонецЕсли;

			КонецЦикла;

			Если Не ПараметрНайден Тогда
				ВызватьИсключение
					"В наборе нового элемента отсутствует параметр: "
					+ ИмяСвойстваPDM
					+ Символы.ПС
					+ "Ресурс: " + ИмяРесурсаКТС
					+ Символы.ПС
					+ "Свойство из CSV: " + Правило.СвойствоPDM;
			КонецЕсли;

		КонецЦикла;

		// ---------------------------------------------------------
		// CREATE_REPRESENTATION
		// ---------------------------------------------------------

		ТекущийЭтап = "CREATE_REPRESENTATION";

		МодульКТС.aps_СоздатьПредставлениеЭлементаРесурса(
			СозданныйОбъект,
			СсылкаРесурса);

		ДиагИмяПослеПредставления = Строка(СозданныйОбъект.Наименование);

		// ---------------------------------------------------------
		// WRITE_ELEMENT
		// ---------------------------------------------------------

		ТекущийЭтап = "WRITE_ELEMENT";

		ДиагИмяДоЗаписи = Строка(СозданныйОбъект.Наименование);
		СозданныйОбъект.Записать();
		ДиагИмяСразуПослеЗаписи = Строка(СозданныйОбъект.Наименование);

		ДиагИмяПослеПовторногоЧтения = "READBACK_NOT_RUN";

		Попытка
			ОбъектПослеЗаписи = СозданныйОбъект.Ссылка.ПолучитьОбъект();
			ДиагИмяПослеПовторногоЧтения = Строка(
				ОбъектПослеЗаписи.Наименование);
		Исключение
			ДиагИмяПослеПовторногоЧтения =
				"READBACK_ERROR=" + ОписаниеОшибки();
		КонецПопытки;

		// ---------------------------------------------------------
		// LINK_TO_RESOURCE
		// ---------------------------------------------------------

		ТекущийЭтап = "LINK_TO_RESOURCE";

		НоваяСвязь = ОбъектРесурса.ЭлементыРесурса.Добавить();
		НоваяСвязь.ЭлементСсылка = СозданныйОбъект.Ссылка;
		НоваяСвязь.ВидСвязи =
			Справочники.aps_ШаблоныТехнологическихСвязей.Ресурсы;

		ОбъектРесурса.Записать();

		// ---------------------------------------------------------
		// CREATE_NOMENCLATURE
		// ---------------------------------------------------------

		ТекущийЭтап = "CREATE_NOMENCLATURE";

		СсылкаНоменклатуры = КТССоздатьНоменклатуруПоИмениЭлемента(
			СозданныйОбъект.Ссылка,
			ПолноеОбозначение);

		// ---------------------------------------------------------
		// COMMIT
		// ---------------------------------------------------------

		ТекущийЭтап = "COMMIT";

		ЗафиксироватьТранзакцию();
		ТранзакцияНачата = Ложь;

		Возврат "TEST_RESULT=CREATED"
			+ Символы.ПС
			+ "SELECTED_RESOURCE=" + ИмяРесурсаКТС
			+ Символы.ПС
			+ "SELECTED_GOST=" + НомерГОСТ
			+ Символы.ПС
			+ "SELECTED_PRODUCT_TYPE=" + ТипИзделия
			+ Символы.ПС
			+ "DIAG_NAME_AFTER_ASSIGN=" + ДиагИмяПослеПрисвоения
			+ Символы.ПС
			+ "DIAG_NAME_AFTER_REPRESENTATION=" + ДиагИмяПослеПредставления
			+ Символы.ПС
			+ "DIAG_NAME_BEFORE_WRITE=" + ДиагИмяДоЗаписи
			+ Символы.ПС
			+ "DIAG_NAME_IMMEDIATELY_AFTER_WRITE=" + ДиагИмяСразуПослеЗаписи
			+ Символы.ПС
			+ "DIAG_NAME_AFTER_WRITE_READBACK=" + ДиагИмяПослеПовторногоЧтения
			+ Символы.ПС
			+ "ELEMENT_NAME=" + ПолноеОбозначение
			+ Символы.ПС
			+ "ELEMENT_REF=" + Строка(СозданныйОбъект.Ссылка)
			+ Символы.ПС
			+ "NOMENCLATURE_REF=" + Строка(СсылкаНоменклатуры);

	Исключение

		ТекстОшибки = ОписаниеОшибки();

		Если ТранзакцияНачата Тогда
			Попытка
				ОтменитьТранзакцию();
			Исключение
			КонецПопытки;
		КонецЕсли;

		Возврат "TEST_RESULT=FAILED"
			+ Символы.ПС
			+ "FAILED_STAGE=" + ТекущийЭтап
			+ Символы.ПС
			+ "ERROR=" + ТекстОшибки;

	КонецПопытки;

КонецФункции


Функция ДекодироватьHEXКТС(ХексСтрока)

	Если ПустаяСтрока(ХексСтрока) Тогда
		ВызватьИсключение "Получена пустая HEX-строка.";
	КонецЕсли;

	Если СтрДлина(ХексСтрока) % 4 <> 0 Тогда
		ВызватьИсключение
			"Длина UTF-16 HEX должна делиться на 4.";
	КонецЕсли;

	Результат = "";
	ЦифрыHEX = "0123456789ABCDEF";

	Для Позиция = 1 По СтрДлина(ХексСтрока) Цикл

		Если (Позиция - 1) % 4 <> 0 Тогда
			Продолжить;
		КонецЕсли;

		HEXСимвол = ВРег(Сред(ХексСтрока, Позиция, 4));
		КодСимвола = 0;

		Для ИндексЦифры = 1 По 4 Цикл

			ТекущаяЦифра = Сред(HEXСимвол, ИндексЦифры, 1);
			ЗначениеЦифры = Найти(ЦифрыHEX, ТекущаяЦифра) - 1;

			Если ЗначениеЦифры < 0 Тогда
				ВызватьИсключение
					"Недопустимый HEX-символ в позиции "
					+ Строка(Позиция + ИндексЦифры - 1);
			КонецЕсли;

			КодСимвола = КодСимвола * 16 + ЗначениеЦифры;

		КонецЦикла;

		Если КодСимвола = 0 Тогда
			ВызватьИсключение
				"В HEX-строке обнаружен нулевой UTF-16 символ.";
		КонецЕсли;

		Результат = Результат + Символ(КодСимвола);

	КонецЦикла;

	Возврат Результат;

КонецФункции


Функция КТСОпределитьРазделительCSV(СтрокаЗаголовка)

	КоличествоТочекСЗапятой =
		СтрДлина(СтрокаЗаголовка)
		- СтрДлина(СтрЗаменить(СтрокаЗаголовка, ";", ""));

	КоличествоЗапятых =
		СтрДлина(СтрокаЗаголовка)
		- СтрДлина(СтрЗаменить(СтрокаЗаголовка, ",", ""));

	Если КоличествоТочекСЗапятой >= КоличествоЗапятых Тогда
		Возврат ";";
	КонецЕсли;

	Возврат ",";

КонецФункции


Функция КТСРазобратьСтрокуCSV(СтрокаCSV, Разделитель)

	Результат = Новый Массив;
	Поле = "";
	ВКавычках = Ложь;
	Позиция = 1;

	Пока Позиция <= СтрДлина(СтрокаCSV) Цикл

		СимволТекста = Сред(СтрокаCSV, Позиция, 1);

		Если СимволТекста = """" Тогда

			Если ВКавычках
				И Позиция < СтрДлина(СтрокаCSV)
				И Сред(СтрокаCSV, Позиция + 1, 1) = """" Тогда

				Поле = Поле + """";
				Позиция = Позиция + 2;
				Продолжить;

			КонецЕсли;

			ВКавычках = Не ВКавычках;

		ИначеЕсли СимволТекста = Разделитель И Не ВКавычках Тогда

			Результат.Добавить(Поле);
			Поле = "";

		Иначе

			Поле = Поле + СимволТекста;

		КонецЕсли;

		Позиция = Позиция + 1;

	КонецЦикла;

	Результат.Добавить(Поле);

	Возврат Результат;

КонецФункции


Функция КТСИндексКолонки(Заголовки, ИмяКолонки)

	Для Индекс = 0 По Заголовки.Количество() - 1 Цикл

		Если СокрЛП(Заголовки[Индекс]) = ИмяКолонки Тогда
			Возврат Индекс;
		КонецЕсли;

	КонецЦикла;

	Возврат -1;

КонецФункции


Функция КТСРазобратьПоПравилам(Обозначение, ПравилаНабора)

	Параметры = Новый Соответствие;

	Состояние = КТСРазобратьРекурсивно(
		Обозначение,
		ПравилаНабора,
		0,
		1,
		Параметры);

	Результат = Новый Структура;
	Результат.Вставить("Успех", Состояние.Успех);
	Результат.Вставить("Параметры", Состояние.Параметры);
	Результат.Вставить("Ошибка", Состояние.Ошибка);

	Возврат Результат;

КонецФункции


Функция КТСРазобратьРекурсивно(
	Обозначение,
	Правила,
	ИндексПравила,
	Позиция,
	Параметры)

	ДлинаОбозначения = СтрДлина(Обозначение);

	Если ИндексПравила >= Правила.Количество() Тогда

		Результат = Новый Структура;
		Результат.Вставить("Успех", Позиция > ДлинаОбозначения);
		Результат.Вставить("Параметры", Параметры);
		Результат.Вставить("ИндексОшибки", ИндексПравила);
		Результат.Вставить("ПозицияОшибки", Позиция);

		Если Позиция > ДлинаОбозначения Тогда
			Результат.Вставить("Ошибка", "");
		Иначе
			Результат.Вставить(
				"Ошибка",
				"Остался неразобранный фрагмент с позиции "
				+ Строка(Позиция) + ": «"
				+ Сред(Обозначение, Позиция) + "»."
				+ " Полностью разобрано "
				+ Строка(Позиция - 1) + " из "
				+ Строка(ДлинаОбозначения) + " символов.");
		КонецЕсли;

		Возврат Результат;

	КонецЕсли;

	Правило = Правила[ИндексПравила];
	Разделитель = Правило.Разделитель;
	ПозицияЗначения = Позиция;

	Если Не ПустаяСтрока(Разделитель) Тогда

		Если КТССовпадаетРазделитель(
			Обозначение, Позиция, Разделитель) Тогда

			ПозицияЗначения = Позиция + СтрДлина(Разделитель);

		ИначеЕсли Не Правило.Обязательный Тогда

			// Необязательное поле с разделителем пропускается целиком.
			// Возвращаем ошибку следующего поля, чтобы не маскировать причину.
			КопияПараметров = КТСКопироватьСоответствие(Параметры);
			Возврат КТСРазобратьРекурсивно(
				Обозначение,
				Правила,
				ИндексПравила + 1,
				Позиция,
				КопияПараметров);

		Иначе

			Возврат КТСОшибкаРазбораПоля(
				Обозначение, Правила, ИндексПравила,
				Позиция, Параметры,
				"обязательный разделитель отсутствует");

		КонецЕсли;

	КонецЕсли;

	МаксимальнаяДлина = ДлинаОбозначения - ПозицияЗначения + 1;
	Если МаксимальнаяДлина < 0 Тогда
		МаксимальнаяДлина = 0;
	КонецЕсли;

	ЛучшаяОшибка = Неопределено;
	ЛучшаяГлубина = -1;
	ЕстьКандидатПоМаске = Ложь;

	Для НомерКандидата = 1 По МаксимальнаяДлина Цикл

		ДлинаКандидата = МаксимальнаяДлина - НомерКандидата + 1;
		Кандидат = Сред(
			Обозначение,
			ПозицияЗначения,
			ДлинаКандидата);

		Если Не КТССоответствуетМаске(
			Кандидат, Правило.ТипПравила) Тогда
			Продолжить;
		КонецЕсли;

		ЕстьКандидатПоМаске = Истина;
		КопияПараметров = КТСКопироватьСоответствие(Параметры);
		КопияПараметров.Вставить(Правило.ПолеПараметра, Кандидат);

		РезультатПродолжения = КТСРазобратьРекурсивно(
			Обозначение,
			Правила,
			ИндексПравила + 1,
			ПозицияЗначения + ДлинаКандидата,
			КопияПараметров);

		Если РезультатПродолжения.Успех Тогда
			Возврат РезультатПродолжения;
		КонецЕсли;

		Если РезультатПродолжения.ИндексОшибки > ЛучшаяГлубина Тогда
			ЛучшаяОшибка = РезультатПродолжения;
			ЛучшаяГлубина = РезультатПродолжения.ИндексОшибки;
		КонецЕсли;

	КонецЦикла;

	Если Не Правило.Обязательный Тогда

		КопияПараметров = КТСКопироватьСоответствие(Параметры);
		РезультатПропуска = КТСРазобратьРекурсивно(
			Обозначение,
			Правила,
			ИндексПравила + 1,
			Позиция,
			КопияПараметров);

		Если РезультатПропуска.Успех Тогда
			Возврат РезультатПропуска;
		КонецЕсли;

		Если РезультатПропуска.ИндексОшибки > ЛучшаяГлубина Тогда
			ЛучшаяОшибка = РезультатПропуска;
			ЛучшаяГлубина = РезультатПропуска.ИндексОшибки;
		КонецЕсли;

	КонецЕсли;

	Если ЛучшаяОшибка <> Неопределено Тогда
		Возврат ЛучшаяОшибка;
	КонецЕсли;

	Если ЕстьКандидатПоМаске Тогда
		Причина = "значение соответствует маске, но последующие поля не разобраны";
	Иначе
		Причина = "ни один фрагмент от текущей позиции не соответствует маске";
	КонецЕсли;

	Возврат КТСОшибкаРазбораПоля(
		Обозначение, Правила, ИндексПравила,
		ПозицияЗначения, Параметры, Причина);

КонецФункции


Функция КТСОшибкаРазбораПоля(
	Обозначение,
	Правила,
	ИндексПравила,
	Позиция,
	Параметры,
	Причина)

	Правило = Правила[ИндексПравила];
	ДлинаОбозначения = СтрДлина(Обозначение);

	Если Позиция <= ДлинаОбозначения Тогда
		Остаток = Сред(Обозначение, Позиция);
		ТекущийСимвол = Сред(Обозначение, Позиция, 1);
	Иначе
		Остаток = "<конец строки>";
		ТекущийСимвол = "<конец строки>";
	КонецЕсли;

	Если ПустаяСтрока(Правило.Разделитель) Тогда
		ТекстРазделителя = "<нет>";
	Иначе
		ТекстРазделителя = Правило.Разделитель;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Параметры", Параметры);
	Результат.Вставить("ИндексОшибки", ИндексПравила);
	Результат.Вставить("ПозицияОшибки", Позиция);
	Результат.Вставить(
		"Ошибка",
		"Поле «" + Правило.ПолеПараметра + "» не разобрано. "
		+ "Правило/маска: «" + Правило.ТипПравила + "». "
		+ "Причина: " + Причина + ". "
		+ "Позиция: " + Строка(Позиция) + " из "
		+ Строка(ДлинаОбозначения) + ". "
		+ "Текущий символ: «" + ТекущийСимвол + "». "
		+ "Остаток строки: «" + Остаток + "». "
		+ "Разделитель: «" + ТекстРазделителя + "». "
		+ "Обязательное: " + ?(Правило.Обязательный, "ИСТИНА", "ЛОЖЬ") + ".");

	Возврат Результат;

КонецФункции


Функция КТСКопироватьСоответствие(ИсходноеСоответствие)

	Копия = Новый Соответствие;

	Для Каждого Элемент Из ИсходноеСоответствие Цикл
		Копия.Вставить(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;

	Возврат Копия;

КонецФункции


Функция КТССовпадаетРазделитель(Строка, Позиция, Разделитель)

	Если ПустаяСтрока(Разделитель) Тогда
		Возврат Истина;
	КонецЕсли;

	Если Позиция < 1
		Или Позиция + СтрДлина(Разделитель) - 1
			> СтрДлина(Строка) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Сред(Строка, Позиция, СтрДлина(Разделитель))
		= Разделитель;

КонецФункции


Функция КТССоответствуетМаске(Значение, Маска)

	Если ПустаяСтрока(Значение)
		Или ПустаяСтрока(Маска) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат КТСМаскаРекурсивно(Значение, Маска, 1, 1);

КонецФункции


Функция КТСМаскаРекурсивно(
	Значение,
	Маска,
	ПозицияЗначения,
	ПозицияМаски)

	ДлинаЗначения = СтрДлина(Значение);
	ДлинаМаски = СтрДлина(Маска);

	Если ПозицияМаски > ДлинаМаски Тогда
		Возврат ПозицияЗначения > ДлинаЗначения;
	КонецЕсли;

	Если Сред(Маска, ПозицияМаски, 1) = "{" Тогда

		ОстатокМаски = Сред(Маска, ПозицияМаски);
		СмещениеКонцаТокена = Найти(ОстатокМаски, "}");

		Если СмещениеКонцаТокена = 0 Тогда
			Возврат Ложь;
		КонецЕсли;

		КонецТокена = ПозицияМаски + СмещениеКонцаТокена - 1;

		Токен = Сред(
			Маска,
			ПозицияМаски + 1,
			КонецТокена - ПозицияМаски - 1);

		// Специальный токен группы материала.
		// Допустимые значения: 21–26 и 31–35.
		Если ВРег(Токен) = "G" Тогда

			Если ПозицияЗначения + 1 > ДлинаЗначения Тогда
				Возврат Ложь;
			КонецЕсли;

			ЗначениеГруппы = Сред(
				Значение,
				ПозицияЗначения,
				2);

			Если ЗначениеГруппы <> "21"
				И ЗначениеГруппы <> "22"
				И ЗначениеГруппы <> "23"
				И ЗначениеГруппы <> "24"
				И ЗначениеГруппы <> "25"
				И ЗначениеГруппы <> "26"
				И ЗначениеГруппы <> "31"
				И ЗначениеГруппы <> "32"
				И ЗначениеГруппы <> "33"
				И ЗначениеГруппы <> "34"
				И ЗначениеГруппы <> "35" Тогда

				Возврат Ложь;

			КонецЕсли;

			Возврат КТСМаскаРекурсивно(
				Значение,
				Маска,
				ПозицияЗначения + 2,
				КонецТокена + 1);

		КонецЕсли;

		Двоеточие = Найти(Токен, ":");

		Если Двоеточие = 0 Тогда
			Возврат Ложь;
		КонецЕсли;

		ТипТокена = ВРег(Лев(Токен, Двоеточие - 1));
		Диапазон = Сред(Токен, Двоеточие + 1);
		ПозицияДефиса = Найти(Диапазон, "-");

		Если ПозицияДефиса = 0 Тогда
			Минимум = Число(Диапазон);
			Максимум = Минимум;
		Иначе
			Минимум = Число(Лев(Диапазон, ПозицияДефиса - 1));
			Максимум = Число(Сред(Диапазон, ПозицияДефиса + 1));
		КонецЕсли;

		Если Минимум < 1 Или Максимум < Минимум Тогда
			Возврат Ложь;
		КонецЕсли;

		// Новый тип M — метрическая резьба:
		// целая часть из 1–2 цифр;
		// необязательная дробная часть через запятую;
		// после запятой должна быть хотя бы одна цифра.
		Если ТипТокена = "M" Тогда

			Если ПозицияЗначения > ДлинаЗначения Тогда
				Возврат Ложь;
			КонецЕсли;

			ДлинаЦелойЧасти = 0;

			Пока ПозицияЗначения + ДлинаЦелойЧасти
				<= ДлинаЗначения Цикл

				СимволЦелойЧасти = Сред(
					Значение,
					ПозицияЗначения + ДлинаЦелойЧасти,
					1);

				Если Найти(
					"0123456789",
					СимволЦелойЧасти) = 0 Тогда
					Прервать;
				КонецЕсли;

				ДлинаЦелойЧасти = ДлинаЦелойЧасти + 1;

				Если ДлинаЦелойЧасти >= Максимум Тогда
					Прервать;
				КонецЕсли;

			КонецЦикла;

			Если ДлинаЦелойЧасти < Минимум Тогда
				Возврат Ложь;
			КонецЕсли;

			// Проверяем вариант без дробной части.
			Если КТСМаскаРекурсивно(
				Значение,
				Маска,
				ПозицияЗначения + ДлинаЦелойЧасти,
				КонецТокена + 1) Тогда

				Возврат Истина;

			КонецЕсли;

			// Дробная часть разрешена только через запятую.
			ПозицияЗапятой = ПозицияЗначения + ДлинаЦелойЧасти;

			Если ПозицияЗапятой <= ДлинаЗначения
				И Сред(Значение, ПозицияЗапятой, 1) = "," Тогда

				ДлинаДробнойЧасти = 0;
				ПозицияПервойЦифры = ПозицияЗапятой + 1;

				Пока ПозицияПервойЦифры + ДлинаДробнойЧасти
					<= ДлинаЗначения Цикл

					СимволДробнойЧасти = Сред(
						Значение,
						ПозицияПервойЦифры + ДлинаДробнойЧасти,
						1);

					Если Найти(
						"0123456789",
						СимволДробнойЧасти) = 0 Тогда
						Прервать;
					КонецЕсли;

					ДлинаДробнойЧасти = ДлинаДробнойЧасти + 1;

				КонецЦикла;

				Если ДлинаДробнойЧасти > 0 Тогда

					Возврат КТСМаскаРекурсивно(
						Значение,
						Маска,
						ПозицияПервойЦифры + ДлинаДробнойЧасти,
						КонецТокена + 1);

				КонецЕсли;

			КонецЕсли;

			Возврат Ложь;

		КонецЕсли;

		ДоступнаяДлина = 0;
		КоличествоЦифр = 0;
		ЕстьДесятичныйРазделитель = Ложь;

		// Для D диапазон задает количество цифр.
		// Точка или запятая допускается дополнительно.
		Пока ПозицияЗначения + ДоступнаяДлина
			<= ДлинаЗначения Цикл

			ТекущийСимвол = Сред(
				Значение,
				ПозицияЗначения + ДоступнаяДлина,
				1);

			Если ТипТокена = "D" Тогда

				Если Найти("0123456789", ТекущийСимвол) > 0 Тогда

					Если КоличествоЦифр >= Максимум Тогда
						Прервать;
					КонецЕсли;

					КоличествоЦифр = КоличествоЦифр + 1;

				ИначеЕсли (ТекущийСимвол = "."
					Или ТекущийСимвол = ",")
					И Не ЕстьДесятичныйРазделитель
					И КоличествоЦифр > 0 Тогда

					ЕстьДесятичныйРазделитель = Истина;

				Иначе
					Прервать;
				КонецЕсли;

				ДоступнаяДлина = ДоступнаяДлина + 1;

			Иначе

				Если ДоступнаяДлина >= Максимум
					Или Не КТСПроверитьТипСимвола(
						ТекущийСимвол,
						ТипТокена) Тогда

					Прервать;
				КонецЕсли;

				ДоступнаяДлина = ДоступнаяДлина + 1;

			КонецЕсли;

		КонецЦикла;

		Если ТипТокена = "D" Тогда

			ДлинаТокена = ДоступнаяДлина;

			Пока ДлинаТокена >= 1 Цикл

				ФрагментТокена = Сред(
					Значение,
					ПозицияЗначения,
					ДлинаТокена);

				ЦифрВоФрагменте = 0;
				РазделителейВоФрагменте = 0;
				ФрагментКорректен = Истина;

				Для ИндексСимвола = 1
					По СтрДлина(ФрагментТокена) Цикл

					СимволФрагмента = Сред(
						ФрагментТокена,
						ИндексСимвола,
						1);

					Если Найти(
						"0123456789",
						СимволФрагмента) > 0 Тогда

						ЦифрВоФрагменте =
							ЦифрВоФрагменте + 1;

					ИначеЕсли СимволФрагмента = "."
						Или СимволФрагмента = "," Тогда

						РазделителейВоФрагменте =
							РазделителейВоФрагменте + 1;

					Иначе
						ФрагментКорректен = Ложь;
					КонецЕсли;

				КонецЦикла;

				Если ФрагментКорректен
					И ЦифрВоФрагменте >= Минимум
					И ЦифрВоФрагменте <= Максимум
					И РазделителейВоФрагменте <= 1
					И Лев(ФрагментТокена, 1) <> "."
					И Лев(ФрагментТокена, 1) <> ","
					И Прав(ФрагментТокена, 1) <> "."
					И Прав(ФрагментТокена, 1) <> "," Тогда

					Если КТСМаскаРекурсивно(
						Значение,
						Маска,
						ПозицияЗначения + ДлинаТокена,
						КонецТокена + 1) Тогда

						Возврат Истина;
					КонецЕсли;

				КонецЕсли;

				ДлинаТокена = ДлинаТокена - 1;

			КонецЦикла;

			Возврат Ложь;

		КонецЕсли;

		Если ДоступнаяДлина < Минимум Тогда
			Возврат Ложь;
		КонецЕсли;

		ДлинаТокена = ДоступнаяДлина;

		Пока ДлинаТокена >= Минимум Цикл

			Если КТСМаскаРекурсивно(
				Значение,
				Маска,
				ПозицияЗначения + ДлинаТокена,
				КонецТокена + 1) Тогда

				Возврат Истина;
			КонецЕсли;

			ДлинаТокена = ДлинаТокена - 1;

		КонецЦикла;

		Возврат Ложь;

	КонецЕсли;

	Если ПозицияЗначения > ДлинаЗначения Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Сред(Значение, ПозицияЗначения, 1)
		<> Сред(Маска, ПозицияМаски, 1) Тогда

		Возврат Ложь;

	КонецЕсли;

	Возврат КТСМаскаРекурсивно(
		Значение,
		Маска,
		ПозицияЗначения + 1,
		ПозицияМаски + 1);

КонецФункции


Функция КТСПроверитьТипСимвола(СимволЗначения, ТипТокена)

	Если ПустаяСтрока(СимволЗначения) Тогда
		Возврат Ложь;
	КонецЕсли;

	ТипТокена = ВРег(ТипТокена);

	Если ТипТокена = "N" Тогда
		Возврат Найти("0123456789", СимволЗначения) > 0;
	КонецЕсли;

	Если ТипТокена = "D" Тогда
		Возврат Найти("0123456789.,", СимволЗначения) > 0;
	КонецЕсли;

	Если ТипТокена = "A" Или ТипТокена = "L" Тогда
		Возврат КТСЭтоБуква(СимволЗначения);
	КонецЕсли;

	Если ТипТокена = "AN" Тогда
		Возврат КТСЭтоБуква(СимволЗначения)
			Или Найти("0123456789", СимволЗначения) > 0;
	КонецЕсли;

	Возврат Ложь;

КонецФункции


Функция КТСЭтоБуква(СимволЗначения)

	Если ПустаяСтрока(СимволЗначения) Тогда
		Возврат Ложь;
	КонецЕсли;

	СимволВерхний = ВРег(СимволЗначения);
	СимволНижний = НРег(СимволЗначения);

	Возврат СимволВерхний <> СимволНижний;

КонецФункции


Функция КТССоздатьНоменклатуруПоИмениЭлемента(СсылкаЭлементаКТС, ИмяЭлемента) Экспорт

	Если Не ЗначениеЗаполнено(СсылкаЭлементаКТС) Тогда
		ВызватьИсключение
			"КТССоздатьНоменклатуруПоИмениЭлемента: не передана ссылка элемента КТС.";
	КонецЕсли;

	Если ПустаяСтрока(ИмяЭлемента) Тогда
		ВызватьИсключение
			"КТССоздатьНоменклатуруПоИмениЭлемента: имя элемента КТС пустое.";
	КонецЕсли;

	// Получаем объект элемента КТС.
	ЭлементКТС = СсылкаЭлементаКТС.ПолучитьОбъект();

	Если ЭлементКТС = Неопределено Тогда
		ВызватьИсключение
			"КТССоздатьНоменклатуруПоИмениЭлемента: не удалось получить объект элемента КТС.";
	КонецЕсли;

	// Ищем свойство «Группа» в параметрах элемента КТС.
	ГруппаЭлементаКТС = Неопределено;

	Для Каждого СтрокаПараметра Из ЭлементКТС.Параметры Цикл

		Если Не ЗначениеЗаполнено(СтрокаПараметра.Параметр) Тогда
			Продолжить;
		КонецЕсли;

		Если СтрокаПараметра.Параметр.Свойство
			= ПланыВидовХарактеристик.aps_Свойства.Группа Тогда

			ГруппаЭлементаКТС = СтрокаПараметра.Параметр.Значение;
			Прервать;

		КонецЕсли;

	КонецЦикла;

	Если Не ЗначениеЗаполнено(ГруппаЭлементаКТС) Тогда
		ВызватьИсключение
			"КТССоздатьНоменклатуруПоИмениЭлемента: не найдено заполненное значение свойства «Группа» в параметрах элемента КТС.";
	КонецЕсли;

	// Получаем наименование группы.
	НаименованиеГруппы = "";

	Попытка
		НаименованиеГруппы = Строка(ГруппаЭлементаКТС.Наименование);
	Исключение
		НаименованиеГруппы = Строка(ГруппаЭлементаКТС);
	КонецПопытки;

	Если ПустаяСтрока(НаименованиеГруппы) Тогда
		ВызватьИсключение
			"КТССоздатьНоменклатуруПоИмениЭлемента: не удалось определить наименование группы.";
	КонецЕсли;

	// Находим заранее созданный вид номенклатуры с таким же наименованием.
	ВидНоменклатуры = Справочники.ВидыНоменклатуры.НайтиПоНаименованию(
		НаименованиеГруппы);

	Если ВидНоменклатуры.Пустая() Тогда
		ВызватьИсключение
			"КТССоздатьНоменклатуруПоИмениЭлемента: вид номенклатуры «"
			+ НаименованиеГруппы
			+ "» не найден. Создание номенклатуры отменено.";
	КонецЕсли;

	// Создаём объект и заполняем его по виду номенклатуры.
	НоменклатураОбъект = Справочники.Номенклатура.СоздатьЭлемент();

	НоменклатураОбъект.Наименование = ИмяЭлемента;
	НоменклатураОбъект.НаименованиеПолное = ИмяЭлемента;
	НоменклатураОбъект.ВидНоменклатуры = ВидНоменклатуры;
	НоменклатураОбъект.ИспользованиеХарактеристик =
		Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать;

	Справочники.Номенклатура.ЗаполнитьПоВидуНоменклатуры(
		НоменклатураОбъект);

	// Восстанавливаем ключевые значения после заполнения по виду.
	НоменклатураОбъект.Наименование = ИмяЭлемента;
	НоменклатураОбъект.НаименованиеПолное = ИмяЭлемента;
	НоменклатураОбъект.ВидНоменклатуры = ВидНоменклатуры;
	НоменклатураОбъект.ИспользованиеХарактеристик =
		Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать;

	// Переносим реквизиты заполненного объекта в структуру,
	// которую обрабатывает штатный механизм PDM.
	СтруктураРеквизитовНоменклатуры = Новый Структура;

	Для Каждого МетаданныеРеквизита Из Метаданные.Справочники.Номенклатура.Реквизиты Цикл

		ИмяРеквизита = МетаданныеРеквизита.Имя;

		СтруктураРеквизитовНоменклатуры.Вставить(
			ИмяРеквизита,
			НоменклатураОбъект[ИмяРеквизита]);

	КонецЦикла;

	// Гарантируем передачу обязательных реквизитов.
	СтруктураРеквизитовНоменклатуры.Вставить(
		"Наименование",
		ИмяЭлемента);

	СтруктураРеквизитовНоменклатуры.Вставить(
		"НаименованиеПолное",
		ИмяЭлемента);

	СтруктураРеквизитовНоменклатуры.Вставить(
		"ВидНоменклатуры",
		ВидНоменклатуры);

	СтруктураРеквизитовНоменклатуры.Вставить(
		"ИспользованиеХарактеристик",
		Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать);

	// Создаём номенклатуру штатным механизмом PDM.
	МодульСозданияНоменклатуры = Обработки.aps_СозданиеОбъектов.Создать();

	СсылкаНоменклатуры = МодульСозданияНоменклатуры.aps_СозданиеПозицииНоменклатуры(
		СтруктураРеквизитовНоменклатуры,
		СсылкаЭлементаКТС,
		Истина);

	Если Не ЗначениеЗаполнено(СсылкаНоменклатуры) Тогда
		ВызватьИсключение
			"aps_СозданиеПозицииНоменклатуры не вернула ссылку созданной номенклатуры.";
	КонецЕсли;

	Возврат СсылкаНоменклатуры;

КонецФункции
