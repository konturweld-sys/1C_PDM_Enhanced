
////////////////////////////////////////////////////////////////////////////////
// ОБЩИЙ МОДУЛЬ: ПДМ_ЖурналИнтеграции
//
// Назначение:
// Журналирование работы интеграции 1С PDM → RabbitMQ.
//
// Файл:
// D:\1C Log\PDM_Nomenclature_Integration.log
//
// Файл дополняется. Предыдущие записи не удаляются.
////////////////////////////////////////////////////////////////////////////////

Процедура Записать(Уровень, Этап, Текст) Экспорт

	Запись = Неопределено;

	Попытка

		КаталогЖурнала = "D:\1C Log";

		ФайлКаталога = Новый Файл(КаталогЖурнала);

		Если Не ФайлКаталога.Существует() Тогда
			СоздатьКаталог(КаталогЖурнала);
		КонецЕсли;

		ПутьКФайлу =
			КаталогЖурнала
			+ "\PDM_Nomenclature_Integration.log";

		Запись = Новый ЗаписьТекста(
			ПутьКФайлу,
			КодировкаТекста.UTF8,
			Символы.ПС,
			Истина
		);

		СтрокаЖурнала =
			Формат(ТекущаяДата(), "ДФ=yyyy-MM-dd HH:mm:ss")
			+ " | "
			+ Строка(Уровень)
			+ " | "
			+ Строка(Этап)
			+ " | "
			+ Строка(Текст);

		Запись.ЗаписатьСтроку(СтрокаЖурнала);
		Запись.Закрыть();

	Исключение

		ТекстОшибки =
			ПодробноеПредставлениеОшибки(
				ИнформацияОбОшибке()
			);

		Если Запись <> Неопределено Тогда
			Попытка
				Запись.Закрыть();
			Исключение
			КонецПопытки;
		КонецЕсли;

		ВызватьИсключение
			"Ошибка записи журнала PDM: " + ТекстОшибки;

	КонецПопытки;

КонецПроцедуры


Функция ПДМ_ПроверитьЗаписьЖурнала() Экспорт

	Запись = Неопределено;

	КаталогЖурнала = "D:\1C Log";

	ПутьКФайлу =
		КаталогЖурнала
		+ "\PDM_Nomenclature_Integration.log";

	Попытка

		ФайлКаталога = Новый Файл(КаталогЖурнала);

		Если Не ФайлКаталога.Существует() Тогда
			СоздатьКаталог(КаталогЖурнала);
		КонецЕсли;

		ФайлКаталога = Новый Файл(КаталогЖурнала);

		Если Не ФайлКаталога.Существует() Тогда
			Возврат "ОШИБКА: каталог D:\1C Log не создан.";
		КонецЕсли;

		Запись = Новый ЗаписьТекста(
			ПутьКФайлу,
			КодировкаТекста.UTF8,
			Символы.ПС,
			Истина
		);

		Запись.ЗаписатьСтроку(
			"ПРОВЕРКА ЗАПИСИ ЖУРНАЛА: "
			+ Строка(ТекущаяДата())
		);

		Запись.Закрыть();
		Запись = Неопределено;

		ФайлЖурнала = Новый Файл(ПутьКФайлу);

		Если Не ФайлЖурнала.Существует() Тогда
			Возврат "ОШИБКА: файл после записи не найден.";
		КонецЕсли;

		Возврат
			"УСПЕХ: файл создан и доступен для записи: "
			+ ПутьКФайлу;

	Исключение

		Если Запись <> Неопределено Тогда
			Попытка
				Запись.Закрыть();
			Исключение
			КонецПопытки;
		КонецЕсли;

		Возврат
			"ОШИБКА ЗАПИСИ ЖУРНАЛА:"
			+ Символы.ПС
			+ ПодробноеПредставлениеОшибки(
				ИнформацияОбОшибке()
			);

	КонецПопытки;

КонецФункции
