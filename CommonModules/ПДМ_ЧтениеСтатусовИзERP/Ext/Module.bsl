
////////////////////////////////////////////////////////////////////////////////
// ТРАНСПОРТ ERP -> PDM
//
// Получение квитанций о результате переноса номенклатуры.
// RabbitMQ queue: erp_to_pdm_statuses
// Exchange: 1c_integration
// Routing key: status_key
////////////////////////////////////////////////////////////////////////////////


////////////////////////////////////////////////////////////////////////////////
// СОЗДАНИЕ ПОДКЛЮЧЕНИЯ К RABBITMQ
////////////////////////////////////////////////////////////////////////////////

Функция ПДМ_СоздатьБрокерДляЧтенияСтатусов() Экспорт

    Настройки = ПДМ_ИнтеграцияRabbitMQ.ПДМ_ПолучитьНастройки();

    Если Настройки = Неопределено Тогда
        ВызватьИсключение "Не найдены настройки RabbitMQ PDM.";
    КонецЕсли;

    Если Не ЗначениеЗаполнено(Настройки.Сервер) Тогда
        ВызватьИсключение "Не задан сервер RabbitMQ.";
    КонецЕсли;

    ПодключитьВнешнююКомпоненту(
        "ОбщийМакет.PinkRabbitMQ",
        "BITERP",
        ТипВнешнейКомпоненты.Native
    );

    Брокер = Новый("AddIn.BITERP.PinkRabbitMQ");

    Брокер.Connect(
        Настройки.Сервер,
        Настройки.Порт,
        Настройки.Пользователь,
        Настройки.Пароль,
        Настройки.ВиртуальныйХост
    );

    ТекстОшибки = Брокер.GetLastError();

    Если ЗначениеЗаполнено(ТекстОшибки) Тогда
        ВызватьИсключение
            "Ошибка подключения к RabbitMQ: " + ТекстОшибки;
    КонецЕсли;

    Возврат Брокер;

КонецФункции


////////////////////////////////////////////////////////////////////////////////
// ПРИЁМ СТАТУСОВ ERP
////////////////////////////////////////////////////////////////////////////////

Процедура ПДМ_ПрочитатьСтатусыИзERP() Экспорт

    МаксимумСообщений = 100;

    Брокер = Неопределено;
    КоличествоОбработанных = 0;

    Попытка

        Брокер = ПДМ_СоздатьБрокерДляЧтенияСтатусов();

        Брокер.BasicConsume(
            "erp_to_pdm_statuses",
            "",
            Ложь,
            Ложь,
            0
        );

        ТекстОшибки = Брокер.GetLastError();

        Если ЗначениеЗаполнено(ТекстОшибки) Тогда
            ВызватьИсключение
                "Ошибка подписки на очередь статусов ERP: "
                + ТекстОшибки;
        КонецЕсли;

        Пока КоличествоОбработанных < МаксимумСообщений Цикл

            ТекстСообщения = "";
            ТегСообщения = "";

            ЕстьСообщение = Брокер.BasicConsumeMessage(
                "",
                ТекстСообщения,
                ТегСообщения,
                1000
            );

            Если Не ЕстьСообщение Тогда
                Прервать;
            КонецЕсли;

            // Обработка и запись статуса в PDM.
            ПДМ_ОбработатьКвитанцию(ТекстСообщения);

            // Подтверждение только после успешной записи.
            Брокер.BasicAck(ТегСообщения);

            ТекстОшибки = Брокер.GetLastError();

            Если ЗначениеЗаполнено(ТекстОшибки) Тогда
                ВызватьИсключение
                    "Ошибка подтверждения сообщения RabbitMQ: "
                    + ТекстОшибки;
            КонецЕсли;

            КоличествоОбработанных =
                КоличествоОбработанных + 1;

        КонецЦикла;

    Исключение

        ТекстОшибки = ОписаниеОшибки();

        ЗаписьЖурналаРегистрации(
            "Интеграция PDM",
            УровеньЖурналаРегистрации.Ошибка,
            ,
            ,
            "Чтение статусов ERP: " + ТекстОшибки
        );

    КонецПопытки;

    // Завершение подписки.
    Если Брокер <> Неопределено Тогда

        Попытка
            Брокер.BasicCancel("");
        Исключение
            ЗаписьЖурналаРегистрации(
                "Интеграция PDM",
                УровеньЖурналаРегистрации.Предупреждение,
                ,
                ,
                "Ошибка отмены потребителя RabbitMQ: "
                    + ОписаниеОшибки()
            );
        КонецПопытки;

    КонецЕсли;

    ЗаписьЖурналаРегистрации(
        "Интеграция PDM",
        УровеньЖурналаРегистрации.Информация,
        ,
        ,
        "Приём статусов ERP завершён. Обработано: "
            + Строка(КоличествоОбработанных)
    );

КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТКА КВИТАНЦИИ ERP
////////////////////////////////////////////////////////////////////////////////

Процедура ПДМ_ОбработатьКвитанцию(ТекстJSON) Экспорт

    ЧтениеJSON = Новый ЧтениеJSON;

    Попытка

        ЧтениеJSON.УстановитьСтроку(ТекстJSON);
        Квитанция = ПрочитатьJSON(ЧтениеJSON);

    Исключение

        ЧтениеJSON.Закрыть();

        ВызватьИсключение
            "Ошибка разбора квитанции ERP: "
            + ОписаниеОшибки();

    КонецПопытки;

    ЧтениеJSON.Закрыть();

    Если ТипЗнч(Квитанция) <> Тип("Структура") Тогда
        ВызватьИсключение
            "Квитанция ERP не является структурой.";
    КонецЕсли;

    UUID = "";
    Статус = "";
    ТекстОшибки = "";

    Если Не Квитанция.Свойство("PDM_UUID", UUID) Тогда
        ВызватьИсключение
            "В квитанции ERP отсутствует PDM_UUID.";
    КонецЕсли;

    Если Не Квитанция.Свойство("Статус", Статус) Тогда
        ВызватьИсключение
            "В квитанции ERP отсутствует Статус.";
    КонецЕсли;

    Квитанция.Свойство("ТекстОшибки", ТекстОшибки);

    Если Не ЗначениеЗаполнено(UUID) Тогда
        ВызватьИсключение
            "В квитанции ERP пустой PDM_UUID.";
    КонецЕсли;

    Если Не ЗначениеЗаполнено(Статус) Тогда
        ВызватьИсключение
            "В квитанции ERP пустой Статус.";
    КонецЕсли;

    Попытка

        УникальныйИдентификатор =
            Новый УникальныйИдентификатор(UUID);

    Исключение

        ВызватьИсключение
            "Некорректный PDM_UUID в квитанции: "
            + UUID;

    КонецПопытки;

    СсылкаНоменклатуры =
        Справочники.Номенклатура.ПолучитьСсылку(
            УникальныйИдентификатор
        );

    Если СсылкаНоменклатуры.Пустая() Тогда
        ВызватьИсключение
            "В PDM не найдена номенклатура с UUID "
            + UUID;
    КонецЕсли;

    МенеджерЗаписи =
        РегистрыСведений.ПДМ_СтатусыСинхронизацииСERP
            .СоздатьМенеджерЗаписи();

    МенеджерЗаписи.Номенклатура =
        СсылкаНоменклатуры;

    МенеджерЗаписи.Статус = Статус;

    МенеджерЗаписи.ОписаниеОшибки =
        ТекстОшибки;

    МенеджерЗаписи.ДатаОбновления =
        ТекущаяДата();

    МенеджерЗаписи.Записать();

КонецПроцедуры

