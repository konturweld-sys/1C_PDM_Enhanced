
////////////////////////////////////////////////////////////////////////////////
// НАСТРОЙКИ RABBITMQ
////////////////////////////////////////////////////////////////////////////////

Функция ПДМ_ПолучитьНастройки() Экспорт

	Настройки = Новый Структура;
	Настройки.Вставить("Сервер", "192.168.50.173");
	Настройки.Вставить("Порт", 5672);
	Настройки.Вставить("Пользователь", "");
	Настройки.Вставить("Пароль", "");
	Настройки.Вставить("ВиртуальныйХост", "/");
	Настройки.Вставить("TelegramТокенБота", "");
	Настройки.Вставить("TelegramIDЧАТА", "");
	Настройки.Вставить("ИспользоватьОповещения", Ложь);

	Выборка = РегистрыСведений.ПДМ_НастройкиИнтеграцииRabbitMQ.Выбрать();

	Если Выборка.Следующий() Тогда
		Настройки.Сервер = Выборка.Сервер;
		Настройки.Порт = Выборка.Порт;
		Настройки.Пользователь = Выборка.Пользователь;
		Настройки.Пароль = Выборка.Пароль;
		Настройки.ВиртуальныйХост = Выборка.ВиртуальныйХост;
		Настройки.TelegramТокенБота = Выборка.TelegramТокенБота;
		Настройки.TelegramIDЧАТА = Выборка.TelegramIDЧАТА;
		Настройки.ИспользоватьОповещения = Выборка.ИспользоватьОповещения;
	КонецЕсли;

	Если ПустаяСтрока(Настройки.Сервер) Тогда
		Настройки.Сервер = "192.168.50.173";
	КонецЕсли;

	Если Настройки.Порт = 0 Тогда
		Настройки.Порт = 5672;
	КонецЕсли;

	Если ПустаяСтрока(Настройки.ВиртуальныйХост) Тогда
		Настройки.ВиртуальныйХост = "/";
	КонецЕсли;

	Возврат Настройки;

КонецФункции


Процедура ПДМ_СохранитьНастройки(
	Сервер,
	Порт,
	Пользователь,
	Пароль,
	ВиртуальныйХост,
	TelegramТокенБота,
	TelegramIDЧАТА,
	ИспользоватьОповещения) Экспорт

	МЗ = РегистрыСведений.ПДМ_НастройкиИнтеграцииRabbitMQ.СоздатьМенеджерЗаписи();
	МЗ.Прочитать();

	МЗ.Сервер = Сервер;
	МЗ.Порт = Порт;
	МЗ.Пользователь = Пользователь;
	МЗ.Пароль = Пароль;
	МЗ.ВиртуальныйХост = ВиртуальныйХост;
	МЗ.TelegramТокенБота = TelegramТокенБота;
	МЗ.TelegramIDЧАТА = TelegramIDЧАТА;
	МЗ.ИспользоватьОповещения = ИспользоватьОповещения;

	МЗ.Записать();

КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// ФОРМИРОВАНИЕ ИЕРАРХИИ
////////////////////////////////////////////////////////////////////////////////

Функция ПДМ_ПолучитьПутьРодителей(ТекущийРодитель)

	Путь = Новый Массив;

	Пока ЗначениеЗаполнено(ТекущийРодитель) Цикл

		ОбъектРодителя = ТекущийРодитель.ПолучитьОбъект();

		РодительUUID = "";

		Если ЗначениеЗаполнено(ОбъектРодителя.Родитель) Тогда
			РодительUUID = Строка(
				ОбъектРодителя.Родитель.УникальныйИдентификатор()
			);
		КонецЕсли;

		СтруктураПапки = Новый Структура;
		СтруктураПапки.Вставить(
			"UUID",
			Строка(ТекущийРодитель.УникальныйИдентификатор())
		);
		СтруктураПапки.Вставить(
			"Наименование",
			ОбъектРодителя.Наименование
		);
		СтруктураПапки.Вставить("ЭтоГруппа", Истина);
		СтруктураПапки.Вставить("Родитель_UUID", РодительUUID);

		Путь.Вставить(0, СтруктураПапки);

		ТекущийРодитель = ОбъектРодителя.Родитель;

	КонецЦикла;

	Возврат Путь;

КонецФункции


////////////////////////////////////////////////////////////////////////////////
// ФОРМИРОВАНИЕ ПАКЕТА НОМЕНКЛАТУРЫ
////////////////////////////////////////////////////////////////////////////////

Функция ПДМ_СформироватьПакетНоменклатуры(Источник) Экспорт

	Данные = Новый Структура;

	UUID = Строка(Источник.Ссылка.УникальныйИдентификатор());

	Данные.Вставить("UUID", UUID);
	Данные.Вставить("Наименование", Источник.Наименование);
	Данные.Вставить("Артикул", Источник.Артикул);
	Данные.Вставить("ЭтоГруппа", Источник.ЭтоГруппа);

	РодительUUID = "";

	Если ЗначениеЗаполнено(Источник.Родитель) Тогда
		РодительUUID = Строка(
			Источник.Родитель.УникальныйИдентификатор()
		);
	КонецЕсли;

	Данные.Вставить("Родитель_UUID", РодительUUID);
	Данные.Вставить(
		"ПутьРодителей",
		ПДМ_ПолучитьПутьРодителей(Источник.Родитель)
	);

	Если НЕ Источник.ЭтоГруппа Тогда

		Единица = Новый Структура;
		Единица.Вставить("Код", "");
		Единица.Вставить("Наименование", "");

		Если ЗначениеЗаполнено(Источник.ЕдиницаИзмерения) Тогда
			Единица.Код = Источник.ЕдиницаИзмерения.Код;
			Единица.Наименование = Источник.ЕдиницаИзмерения.Наименование;
		КонецЕсли;

		Данные.Вставить("ЕдиницаИзмерения", Единица);

		Данные.Вставить(
			"ТипНоменклатуры",
			Строка(Источник.ТипНоменклатуры)
		);

		Данные.Вставить(
			"ВидНоменклатуры",
			Строка(Источник.ВидНоменклатуры)
		);

		Данные.Вставить(
			"ИспользованиеХарактеристик",
			Строка(Источник.ИспользованиеХарактеристик)
		);

		Данные.Вставить(
			"ВладелецХарактеристик",
			Строка(Источник.ВладелецХарактеристик)
		);

		// Характеристики
		МассивХарактеристик = Новый Массив;

		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Характеристики.Ссылка КАК Ссылка,
		|	Характеристики.Наименование КАК Наименование
		|ИЗ
		|	Справочник.ХарактеристикиНоменклатуры КАК Характеристики
		|ГДЕ
		|	Характеристики.Владелец = &Владелец";

		Запрос.УстановитьПараметр("Владелец", Источник.Ссылка);

		ВыборкаХарактеристик = Запрос.Выполнить().Выбрать();

		Пока ВыборкаХарактеристик.Следующий() Цикл

			Характеристика = Новый Структура;
			Характеристика.Вставить(
				"UUID",
				Строка(
					ВыборкаХарактеристик.Ссылка.УникальныйИдентификатор()
				)
			);
			Характеристика.Вставить(
				"Наименование",
				ВыборкаХарактеристик.Наименование
			);
			Характеристика.Вставить(
				"ЭтоОбщаяХарактеристика",
				Ложь
			);

			МассивХарактеристик.Добавить(Характеристика);

		КонецЦикла;

		Данные.Вставить("Характеристики", МассивХарактеристик);

		// Структура спецификации предусмотрена форматом ТЗ.
		// Состав будет передаваться после подключения фактического
		// источника состава спецификации PDM.
		Спецификация = Новый Структура;
		Спецификация.Вставить(
			"Наименование",
			"Спецификация из PDM " + Источник.Артикул
		);
		Спецификация.Вставить("Состав", Новый Массив);

		Данные.Вставить("Спецификация", Спецификация);

	КонецЕсли;

	Возврат Данные;

КонецФункции


////////////////////////////////////////////////////////////////////////////////
// СЕРИАЛИЗАЦИЯ JSON
////////////////////////////////////////////////////////////////////////////////

Функция ПДМ_ПреобразоватьПакетВJSON(Данные)

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();

	ЗаписатьJSON(ЗаписьJSON, Данные);

	Возврат ЗаписьJSON.Закрыть();

КонецФункции


////////////////////////////////////////////////////////////////////////////////
// ОБНОВЛЕНИЕ СТАТУСА ЛОКАЛЬНОЙ ОТПРАВКИ
////////////////////////////////////////////////////////////////////////////////

Процедура ПДМ_ЗаписатьСтатусОтправки(
	СсылкаНоменклатуры,
	Статус,
	ТекстОшибки = "") Экспорт

	МЗ = РегистрыСведений.ПДМ_СтатусыСинхронизацииСERP.СоздатьМенеджерЗаписи();

	МЗ.Номенклатура = СсылкаНоменклатуры;
	МЗ.Прочитать();

	МЗ.Номенклатура = СсылкаНоменклатуры;
	МЗ.Статус = Статус;
	МЗ.ДатаОбновления = ТекущаяДата();
	МЗ.ОписаниеОшибки = ТекстОшибки;

	МЗ.Записать();

КонецПроцедуры



////////////////////////////////////////////////////////////////////////////////
// ОТПРАВКА ПОЛНОЙ НОМЕНКЛАТУРЫ В RABBITMQ
////////////////////////////////////////////////////////////////////////////////


Процедура ПДМ_ОтправитьПолнуюНоменклатуру(Источник, Отказ) Экспорт

	Настройки = ПДМ_ПолучитьНастройки();

	Если Настройки = Неопределено
		Или ПустаяСтрока(Настройки.Сервер)
		Или ПустаяСтрока(Настройки.Пользователь) Тогда

		ТекстОшибки = "Не заполнены настройки подключения RabbitMQ.";

		Попытка
			ПДМ_ЗаписатьСтатусОтправки(
				Источник.Ссылка,
				"ОшибкаПереноса",
				ТекстОшибки
			);
		Исключение
		КонецПопытки;

		Попытка
			ПДМ_ЖурналИнтеграции.Записать(
				"ERROR",
				"RABBITMQ",
				"UUID: " + Строка(Источник.Ссылка)
				+ ". " + ТекстОшибки
			);
		Исключение
		КонецПопытки;

		ЗаписьЖурналаРегистрации(
			"RabbitMQ_Отправка",
			УровеньЖурналаРегистрации.Ошибка,
			,
			Источник.Ссылка,
			ТекстОшибки
		);

		Попытка
			ПДМ_МониторингСвязиRabbitMQ.ПДМ_ЗафиксироватьСбойСвязи();
		Исключение
		КонецПопытки;

		Возврат;

	КонецЕсли;

	Попытка

		// Формирование пакета существующими функциями модуля.
		Данные = ПДМ_СформироватьПакетНоменклатуры(Источник);
		СтрокаJSON = ПДМ_ПреобразоватьПакетВJSON(Данные);

		Если ПустаяСтрока(СтрокаJSON) Тогда
			ВызватьИсключение "Получен пустой JSON-пакет номенклатуры.";
		КонецЕсли;

		// Загрузка установленной внешней компоненты.
		РезультатПодключения = ПодключитьВнешнююКомпоненту(
			"ОбщийМакет.PinkRabbitMQ",
			"BITERP",
			ТипВнешнейКомпоненты.Native
		);

		Если Не РезультатПодключения Тогда
			ВызватьИсключение
				"Не удалось подключить внешнюю компоненту PinkRabbitMQ.";
		КонецЕсли;

		Брокер = Новый("AddIn.BITERP.PinkRabbitMQ");

		// Connect является процедурой.
		Брокер.Connect(
			Настройки.Сервер,
			Настройки.Порт,
			Настройки.Пользователь,
			Настройки.Пароль,
			Настройки.ВиртуальныйХост
		);

		ОшибкаКомпоненты = Брокер.GetLastError();

		Если Не ПустаяСтрока(ОшибкаКомпоненты) Тогда
			ВызватьИсключение
				"Ошибка подключения RabbitMQ: " + ОшибкаКомпоненты;
		КонецЕсли;

		// Публикация через фактически используемый API компоненты.
		Брокер.BasicPublish(
			"1c_integration",
			"nomenclature_key",
			СтрокаJSON,
			0,
			Истина
		);

		ОшибкаКомпоненты = Брокер.GetLastError();

		Если Не ПустаяСтрока(ОшибкаКомпоненты) Тогда
			ВызватьИсключение
				"Ошибка публикации RabbitMQ: " + ОшибкаКомпоненты;
		КонецЕсли;

		// Освобождаем объект компоненты.
		// Метода Disconnect у установленной компоненты нет.
		Брокер = Неопределено;

		// Запись значимого события в файловый журнал.
		Попытка
			ПДМ_ЖурналИнтеграции.Записать(
				"INFO",
				"RABBITMQ",
				"Пакет номенклатуры опубликован. UUID: "
				+ Строка(Данные.UUID)
				+ "; exchange: 1c_integration"
				+ "; routing key: nomenclature_key."
			);
		Исключение
		КонецПопытки;

		ЗаписьЖурналаРегистрации(
			"RabbitMQ_Отправка",
			УровеньЖурналаРегистрации.Информация,
			,
			Источник.Ссылка,
			"Публикация пакета выполнена. UUID: " + Данные.UUID
		);

		// Окончательный успешный статус устанавливает только квитанция ERP.
		ПДМ_МониторингСвязиRabbitMQ.ПДМ_СброситьСчетчикСбоев();

	Исключение

		ТекстОшибки = КраткоеПредставлениеОшибки(
			ИнформацияОбОшибке()
		);

		Брокер = Неопределено;

		Попытка
			ПДМ_ЗаписатьСтатусОтправки(
				Источник.Ссылка,
				"ОшибкаПереноса",
				ТекстОшибки
			);
		Исключение
		КонецПопытки;

		Попытка
			ПДМ_ЖурналИнтеграции.Записать(
				"ERROR",
				"RABBITMQ",
				"UUID: " + Строка(Источник.Ссылка)
				+ ". " + ТекстОшибки
			);
		Исключение
		КонецПопытки;

		Попытка
			ПДМ_МониторингСвязиRabbitMQ.ПДМ_ЗафиксироватьСбойСвязи();
		Исключение
		КонецПопытки;

		ЗаписьЖурналаРегистрации(
			"RabbitMQ_Отправка",
			УровеньЖурналаРегистрации.Ошибка,
			,
			Источник.Ссылка,
			ТекстОшибки
		);

		// Ошибка обмена не отменяет запись номенклатуры в PDM.
		// Параметр Отказ намеренно не изменяем.

	КонецПопытки;

КонецПроцедуры



////////////////////////////////////////////////////////////////////////////////
// ПРОВЕРКА ПОДКЛЮЧЕНИЯ К RABBITMQ
////////////////////////////////////////////////////////////////////////////////

Функция ПДМ_ПроверитьПодключениеRabbitMQ() Экспорт

	Настройки = ПДМ_ПолучитьНастройки();

	Попытка

		ПодключитьВнешнююКомпоненту(
			"ОбщийМакет.PinkRabbitMQ",
			"BITERP",
			ТипВнешнейКомпоненты.Native
		);

		Брокер = Новый("AddIn.BITERP.PinkRabbitMQ");

		Брокер.Connect(
			Настройки.Сервер,
			Настройки.Порт,
			Настройки.Пользователь,
			Настройки.Пароль,
			Настройки.ВиртуальныйХост
		);

		ТестовоеСообщение =
			"{""test"":true,""source"":""PDM"",""message"":""RabbitMQ connection test""}";

		Брокер.BasicPublish(
			"1c_integration",
			"nomenclature_key",
			ТестовоеСообщение,
			0,
			Истина
		);

		ОшибкаКомпоненты = Брокер.GetLastError();

		Брокер = Неопределено;

		Если ПустаяСтрока(ОшибкаКомпоненты) Тогда

			Возврат "BasicPublish выполнен. "
				+ "GetLastError пуст. Проверь сообщение в очереди.";

		Иначе

			Возврат "Сообщение компоненты: "
				+ ОшибкаКомпоненты;

		КонецЕсли;

	Исключение

		Возврат "Ошибка: "
			+ КраткоеПредставлениеОшибки(
				ИнформацияОбОшибке()
			);

	КонецПопытки;

КонецФункции
