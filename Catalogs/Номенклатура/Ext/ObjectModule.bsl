////////////////////////////////////////////////////////////////////////////////
// ПЕРЕД ЗАПИСЬЮ НОМЕНКЛАТУРЫ
////////////////////////////////////////////////////////////////////////////////

&Перед("ПередЗаписью")
Процедура ПДМ_ПередЗаписьюПеред(Отказ)

    Если ЭтотОбъект.ОбменДанными.Загрузка Тогда
        Возврат;
    КонецЕсли;

    Запрос = Новый Запрос;

    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |   Статусы.Статус КАК Статус
    |ИЗ
    |   РегистрСведений.ПДМ_СтатусыСинхронизацииСERP КАК Статусы
    |ГДЕ
    |   Статусы.Номенклатура = &Номенклатура";

    Запрос.УстановитьПараметр(
        "Номенклатура",
        ЭтотОбъект.Ссылка
    );

    Выборка = Запрос.Выполнить().Выбрать();

    Если Выборка.Следующий()
        И Выборка.Статус = "УспешноПеренесено" Тогда

        Отказ = Истина;

        ВызватьИсключение
            "Карточка уже успешно синхронизирована с ERP.";

    КонецЕсли;

КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// ПОСЛЕ ЗАПИСИ НОМЕНКЛАТУРЫ
////////////////////////////////////////////////////////////////////////////////

&После("ПриЗаписи")
Процедура ПДМ_ПриЗаписиРассылкаВRabbitMQ(Отказ)

    Если ЭтотОбъект.ОбменДанными.Загрузка Тогда
        Возврат;
    КонецЕсли;

    ПДМ_ИнтеграцияRabbitMQ.ПДМ_ОтправитьПолнуюНоменклатуру(
        ЭтотОбъект,
        Отказ
    );

КонецПроцедуры
